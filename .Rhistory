# 8. Using SLR on the Auto dataset
# a. Use the lm() function to perform SLR with mpg as the response and
#    horsepower as the predictor. Use summary() to print results
auto_lm = lm(mpg ~ horsepower, data = auto)
summary(auto_lm)
cor(auto)
cor(horsepower, mpg)
attach(auto)
horsepower
# i-iii. There is a strong negative relationship between horsepower and mpg,
#        with an R2 of -0.77. As a car's horsepower increases, it's mpg/mileage
#        efficiency tends to decrease strongly (i.e. fewer miles per gallon)
# iv. What is the predicted mpg associated with a horsepower of 98? What are the
#     associated 95% confidence and prediction intervals?
predict(auto_lm, horespower = 98,
interval = 'confidence')
# i-iii. There is a strong negative relationship between horsepower and mpg,
#        with an R2 of -0.77. As a car's horsepower increases, it's mpg/mileage
#        efficiency tends to decrease strongly (i.e. fewer miles per gallon)
# iv. What is the predicted mpg associated with a horsepower of 98? What are the
#     associated 95% confidence and prediction intervals?
predict(auto_lm, data.frame(horsepower = (c(98))),
interval = 'confidence')
predict(auto_lm, data.frame(horsepower = (c(98))),
interval = 'prediction')
